{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@undetermini/core/*": ["./packages/core/src/*"],
      "@undetermini/application/*": ["./packages/application/src/*"],
      "@undetermini/cli/*": ["./entrypoints/cli/src/*"],
      "@undetermini/tui/*": ["./entrypoints/tui/src/*"],
      "@undetermini/examples/*": ["./examples/*"]
    }
  },
  "include": ["src", "packages", "entrypoints", "examples"],
  "exclude": ["node_modules", "legacy", "dist", "docs", "scripts"]
}
